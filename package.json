{
  "name": "aerotech",
  "version": "1.0.0",
  "description": "AI-powered company and workforce operating platform",
  "main": "index.js",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "db:migrate": "node scripts/migrate.mjs",
    "test:collaboration:db": "node --import ./tests/helpers/ts-loader.mjs tests/collaboration-db.integration.mjs",
    "test:collaboration:api": "node --experimental-test-module-mocks --import ./tests/helpers/ts-loader.mjs tests/collaboration-api.integration.mjs",
    "test:collaboration:browser": "node scripts/phase2-browser-suite.mjs",
    "verify:paystack:live": "node scripts/verify-paystack-live.mjs",
    "test:events": "node --experimental-test-module-mocks --import ./tests/helpers/ts-loader.mjs tests/event-expiry.integration.mjs",
    "test:payouts": "node --experimental-test-module-mocks --import ./tests/helpers/ts-loader.mjs tests/payout-api.integration.mjs",
    "test:billing": "node --experimental-test-module-mocks --import ./tests/helpers/ts-loader.mjs tests/subscription-billing.integration.mjs",
    "cf:build": "opennextjs-cloudflare build --skipWranglerConfigCheck",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:deploy:staging": "wrangler deploy -c wrangler.aerotech-staging.toml"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drewhlly/Aerotech.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/drewhlly/Aerotech/issues"
  },
  "homepage": "https://github.com/drewhlly/Aerotech#readme",
  "dependencies": {
    "@aws-sdk/client-rekognition": "^3.1156.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.31.0",
    "next": "^16.3.1",
    "pdf-lib": "^1.17.1",
    "pg": "^8.13.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.12",
    "@electric-sql/pglite-socket": "^0.2.15",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.11.11",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "lighthouse": "^13.5.0",
    "playwright": "1.64.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "@opennextjs/cloudflare": "1.20.13",
    "wrangler": "^4.45.0"
  },
  "type": "module"
}
