# Aerotech environment template (never commit real credentials).
# Copy to .env.local for local development. Configure Preview and Production separately in Vercel.
# Values are intentionally blank; use isolated test credentials and a disposable database in development.
# Next.js reads NEXT_PUBLIC_* at build time; changing these requires a rebuild.

# Runtime: PostgreSQL; required for authenticated routes, attendance, and server-side workflows.
DATABASE_URL=
# Build-time / public URL metadata. Do not put secrets in NEXT_PUBLIC_* values.
NEXT_PUBLIC_CANONICAL_URL=https://aerotechhr.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Runtime: only needed when AWS face verification is enabled.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Runtime: email delivery, payments, scheduled jobs, document encryption.
RESEND_API_KEY=
INVITATION_FROM_EMAIL=
SUPPORT_EMAIL=
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
CRON_SECRET=
DOCUMENT_ENCRYPTION_KEY=
PAYOUT_ENCRYPTION_KEY=

# Runtime: conferencing and optional AI integrations.
GEMINI_API_KEY=
CLOUDFLARE_AI_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=

# Do not configure production credentials or production data in preview/test runners.
# NODE_ENV is managed by Next.js / Vercel; no manual override.

# Additional optional runtime integrations. Configure only when enabled.
DOCUMENT_SCAN_TOKEN=
DOCUMENT_SCAN_URL=
NEXT_PUBLIC_CLIENTS_SERVED=
NEXT_PUBLIC_PROFESSIONALS_PLACED=
NEXT_PUBLIC_YEARS_IN_BUSINESS=
OPENAI_API_KEY=
PORTAL_ROOT_DOMAIN=
REPORT_HASH_SECRET=
SUPPORT_INITIAL_AGENT_EMAIL=
SUPPORT_MFA_ENCRYPTION_KEY=
SUPPORT_PHONE=

# CI / browser-audit inputs — not usually needed in Vercel.
APP_BASE_URL=
AUTOMATION_BROWSER_SCRIPT=
CHROME_PATH=
CRAWL_MODE=
INTERVIEW_LIGHTHOUSE=
OUTSTANDING_LIGHTHOUSE=
PHASE2_LIGHTHOUSE=
PHASE2_TEST_ORIGIN=
PWA_CHROME=
QA_CHROME=
SUPPORT_TEST_DEPENDENCIES=

# NODE_ENV and LD_LIBRARY_PATH are platform-managed; do not set them here.

# Optional embedding-only face attendance. Apply migration 047 before enabling.
FACE_ATTENDANCE_ENABLED=false
FACE_MATCH_THRESHOLD=0.45
FACE_REVIEW_THRESHOLD=0.50
# Browser-only liveness is always reviewed; no automatic verified attendance.
FACE_GEOFENCE_ENABLED=false
# Required only when geofence enabled; existing assigned attendance sites take precedence.
FACE_OFFICE_LATITUDE=
FACE_OFFICE_LONGITUDE=
FACE_OFFICE_RADIUS_M=150

# CI only: disposable localhost pgvector database; never a production connection.
FACE_TEST_DATABASE_URL=

# Private embedded meetings. API key is SERVER ONLY; never NEXT_PUBLIC_.
MEETING_PROVIDER=daily
DAILY_API_KEY=
# e.g. your-team.daily.co (no scheme/path)
DAILY_DOMAIN=
# Application reservation ceiling, NOT a promise of free provider usage.
# Daily currently advertises 10,000 free participant-minutes/month (verified 2026-11-19).
# Recheck https://www.daily.co/pricing/video-sdk/ before setting a budget.
MEETING_MONTHLY_BUDGET_MINUTES=8000
MEETING_MAX_PARTICIPANTS=32
MEETING_TOKEN_TTL_SECONDS=300

# Hybrid meetings: external links work without a Daily account/key.
MEETING_BUILT_IN_ENABLED=false
# Comma-separated hostnames; exact host or dot-boundary subdomain only. HTTPS required.
MEETING_EXTERNAL_ALLOWED_DOMAINS=meet.google.com,zoom.us,teams.microsoft.com,teams.live.com
# Per-plan limits live in meeting_plan_limits (migration 049), not this shared account budget.
