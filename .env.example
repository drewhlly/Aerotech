# Aerotech environment template (never commit real credentials).
# Copy to .env.local for local development. Configure Preview and Production separately in Vercel.
# Values are intentionally blank; use isolated test credentials and a disposable database in development.
# Next.js reads NEXT_PUBLIC_* at build time; changing these requires a rebuild.

# Runtime: PostgreSQL; required for authenticated routes, attendance, and server-side workflows.
DATABASE_URL=
# Build-time / public URL metadata. Do not put secrets in NEXT_PUBLIC_* values.
NEXT_PUBLIC_CANONICAL_URL=https://aerotechhr.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Runtime: only needed when AWS face verification is enabled.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Runtime: email delivery, payments, scheduled jobs, document encryption.
RESEND_API_KEY=
INVITATION_FROM_EMAIL=
SUPPORT_EMAIL=
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
CRON_SECRET=
DOCUMENT_ENCRYPTION_KEY=
PAYOUT_ENCRYPTION_KEY=

# Runtime: conferencing and optional AI integrations.
JITSI_DOMAIN=
JITSI_APP_ID=
JITSI_APP_SECRET=
JAAS_APP_ID=
JAAS_KEY_ID=
JAAS_PRIVATE_KEY=
GEMINI_API_KEY=
CLOUDFLARE_AI_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=

# Do not configure production credentials or production data in preview/test runners.
# NODE_ENV is managed by Next.js / Vercel; no manual override.

# Additional optional runtime integrations. Configure only when enabled.
DOCUMENT_SCAN_TOKEN=
DOCUMENT_SCAN_URL=
JITSI_JWT_SUB=
OPENAI_API_KEY=
PORTAL_ROOT_DOMAIN=
REPORT_HASH_SECRET=
SUPPORT_INITIAL_AGENT_EMAIL=
SUPPORT_MFA_ENCRYPTION_KEY=
SUPPORT_PHONE=

# CI / browser-audit inputs — not usually needed in Vercel.
APP_BASE_URL=
AUTOMATION_BROWSER_SCRIPT=
CHROME_PATH=
CRAWL_MODE=
INTERVIEW_LIGHTHOUSE=
OUTSTANDING_LIGHTHOUSE=
PHASE2_LIGHTHOUSE=
PHASE2_TEST_ORIGIN=
PWA_CHROME=
QA_CHROME=
SUPPORT_TEST_DEPENDENCIES=

# NODE_ENV and LD_LIBRARY_PATH are platform-managed; do not set them here.
